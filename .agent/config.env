# .agent/config.env -- repository facts for agent skills.
# Generated by bootstrap-repo.sh. Parsed line-wise, never sourced.
# Regenerate with: bootstrap-repo.sh --force

AGENT_REPO_SLUG=wrzonance/HonkHonk
AGENT_BASE_BRANCH=main
AGENT_PROJECT_OWNER=wrzonance
AGENT_PROJECT_NUMBER=8
AGENT_STATUS_VOCAB=Backlog,Ready,In progress,In review,Done
AGENT_ADR_DIR=docs/adr
AGENT_WORKTREE_ROOT=.worktrees
AGENT_ONBOARDED_BY=agentkit/0.6.4

# This repository's labels, for you to split by intent. Uncomment and
# classify the ones agents should reuse instead of inventing new labels.
#   bug,documentation,duplicate,enhancement,good first issue,help wanted,invalid,question,wontfix,audio,ui,state,tray,packaging,shortcuts,infra,sub-mvp,design,assets,major-update,ci,dependencies,rust,github_actions
AGENT_LABEL_TYPES=bug,enhancement,documentation,question,sub-mvp,design,major-update,dependencies
AGENT_LABEL_AREAS=audio,ui,state,tray,packaging,shortcuts,infra,assets,ci,rust,github_actions
# AGENT_LABEL_PRIORITIES=

# Candidate verify commands found in this repository. Uncomment the ones
# agents should run, as AGENT_CMD_<NAME>=<command>. Commands are argv;
# quote spaces inside one token. No shell, pipes, or redirects.
# For anything more, use .agent/runner.
# component: . (rust, Cargo.toml)
# AGENT_CMD_TEST=cargo test
# AGENT_CMD_LINT=cargo clippy
# AGENT_CMD_FORMAT=cargo fmt --check

# component: . (shell, *.sh)
# shellcheck needs explicit file operands -- argv cannot glob, so choose
# the paths this repository wants checked:
# AGENT_CMD_LINT_SHELL=shellcheck

# Every value above is argv -- no shell, no &&, no pipes -- and none of it has
# been run. Put each command through agent-run.sh before uncommenting it.
AGENT_CMD_VERIFY=cargo clippy --all-targets --all-features -- -D warnings
AGENT_CMD_FORMAT=cargo fmt -- --check
AGENT_CMD_DENY=cargo deny check
AGENT_CMD_TEST=cargo test

# Worker model/effort for dispatched implementation workers. Declare the
# TIER, not a fixed provider model: the resolver reads harness= from the
# environment contract and maps it to that harness's own native worker
# tier, so the same declaration dispatches correctly whichever harness is
# actually running (e.g. gpt-5.6-luna on Codex, claude-sonnet-5 elsewhere).
# AGENT_WORKER_EFFORT (e.g. high) is harness-neutral and applies to any of them.
AGENT_WORKER_MODEL=claude-sonnet-5
AGENT_WORKER_MODEL_FALLBACK=claude-sonnet-5
AGENT_WORKER_EFFORT=high

# Automated review providers expected on pull requests. Choose one or more.
# Supported choices: coderabbit, github-code-quality, or none (none is exclusive).
AGENT_REVIEW_PROVIDERS=coderabbit

# Recorded proposal inventory. These lines are observations only; they
# never declare or execute a command. Refresh replaces this block.
# proposal-component|.|rust|Cargo.toml
# proposal-component|.|shell|*.sh
# proposal-command|AGENT_CMD_FORMAT|cargo|present|
# proposal-command|AGENT_CMD_LINT|cargo|present|
# proposal-command|AGENT_CMD_LINT_SHELL|shellcheck|present|
# proposal-command|AGENT_CMD_TEST|cargo|present|
